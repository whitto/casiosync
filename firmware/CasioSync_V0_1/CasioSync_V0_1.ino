// Unsigned elapsed arithmetic keeps the flash cadence correct through
// millis() rollover. Off clears the output at the next task poll. A Bluetooth
// transaction starts with an immediate ON phase; idle holds eligible success
// steady for 24 hours and is otherwise dark.
static void writeActivityLed(bool on) {
#if defined(ACTIVITY_LED_RGB_PIN)
  rgbLedWrite(ACTIVITY_LED_RGB_PIN, 0, 0, on ? 32 : 0);
#elif !defined(ACTIVITY_LED_UNAVAILABLE)
#if defined(ACTIVITY_LED_ACTIVE_LOW)
  digitalWrite(PIN_ONBOARD_LED, on ? LOW : HIGH);
#else
  digitalWrite(PIN_ONBOARD_LED, on ? HIGH : LOW);
#endif
#else
  (void)on;
#endif
}
static void initializeActivityLed(void) {
#if !defined(ACTIVITY_LED_RGB_PIN) && !defined(ACTIVITY_LED_UNAVAILABLE)
  pinMode(PIN_ONBOARD_LED, OUTPUT);
#endif
  writeActivityLed(false);
}

static bool activityLedLevel(uint32_t nowMs, bool enabled, bool active, bool successEligible,
                             uint32_t &phaseStartMs, bool &level, bool &wasActive)
{
  return BtSyncLed::output(nowMs, enabled, active, successEligible,
                           phaseStartMs, level, wasActive);
}

static bool activityLedSyncActive(void)
{
  // Scanning/Always Wait alone are idle. Busy covers connecting and the
  // actual acknowledged time-delivery transaction, which may block loop().
  return btBleBusy.load();
}

static bool activityLedSuccessEligible(void) {
  const bool successful = btLastOutcomeSuccessful.load(std::memory_order_acquire);
  const uint32_t epoch = btLastSyncEpoch.load(std::memory_order_acquire);
  return BtSyncLed::successEligible((int64_t)time(nullptr), epoch, successful);
}

static void activityLedTask(void *)
{
  uint32_t phaseStartMs = millis();
  bool level = false;
  bool wasActive = false;
  bool writtenLevel = false;
  for (;;) {
    const bool nextLevel = activityLedLevel(millis(), activityLedEnabled.load(),
                                           activityLedSyncActive(), activityLedSuccessEligible(),
                                           phaseStartMs, level, wasActive);
    if (nextLevel != writtenLevel) {
      writeActivityLed(nextLevel);
      writtenLevel = nextLevel;
    }
    vTaskDelay(pdMS_TO_TICKS(50));
  }
}

uint32_t activityLedStackMinimum(void) {
  return activityLedTaskHandle ? (uint32_t)uxTaskGetStackHighWaterMark(activityLedTaskHandle) : 0;
}

static void safetyMonitorTask(void *) {
  for (;;) {
    vTaskDelay(pdMS_TO_TICKS(100));
    if (!safetyMonitorReady.load(std::memory_order_acquire)) continue;
    const uint64_t nowUs = (uint64_t)esp_timer_get_time();
    portENTER_CRITICAL(&progressMux);
    const uint64_t last = applicationLoopLastUs;
    portEXIT_CRITICAL(&progressMux);
    const uint32_t available = (uint32_t)uxTaskGetStackHighWaterMark(nullptr);
    if (available < monitorStackMinimum) monitorStackMinimum = available;
    if (last && nowUs >= last && nowUs-last > LOOP_PROGRESS_DEADLINE_US &&
        applicationLoopAgeMs() > LOOP_PROGRESS_DEADLINE_US / 1000ULL)
      applicationForceSafeRestart();
  }
}

static bool startSafetyMonitor(void) {
  if (safetyMonitorTaskHandle && safetyMonitorReady.load()) return true;
  applicationProgressCheckpoint();
  BaseType_t created;
#if CONFIG_FREERTOS_UNICORE
  created = xTaskCreate(safetyMonitorTask, "safetyMonitor", 2048, nullptr, 1, &safetyMonitorTaskHandle);
#else
  created = xTaskCreatePinnedToCore(safetyMonitorTask, "safetyMonitor", 2048, nullptr, 1,
                                    &safetyMonitorTaskHandle, 0);
#endif
  if (created != pdPASS || !safetyMonitorTaskHandle) {
    safetyMonitorTaskHandle = nullptr;
    Serial.println("ERROR: progress monitor unavailable; Bluetooth startup disabled");
    return false;
  }
  safetyMonitorReady.store(true, std::memory_order_release);
  return true;
}

